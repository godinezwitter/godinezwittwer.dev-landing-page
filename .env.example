# Contact form delivery — Web3Forms (https://web3forms.com).
# Copy this file to `.env` and fill it in. `.env` is git-ignored; on the host /
# in CI set the same variables as build environment variables.

# Access key from web3forms.com, after entering godinezwittwer.dev@gmail.com and
# confirming the email they send. Publishable — only permits posting to this one
# form. Without it the form validates but the send fails closed.
VITE_WEB3FORMS_ACCESS_KEY=

# Only when hCaptcha spam protection is turned ON in the Web3Forms dashboard
# (your form -> Settings -> Spam Protection). Use the sitekey it shows there;
# Web3Forms' default managed hCaptcha sitekey is
# 50b2fe65-b00b-4b9e-ad62-3ba471098be2. Leave blank to keep the site captcha-free
# (also turn hCaptcha off in the dashboard, or submissions get rejected).
VITE_HCAPTCHA_SITEKEY=
